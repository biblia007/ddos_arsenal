-- переопределяем destroy чтобы отключить все connections
local allConnections = {}
local function trackConn(conn)
    allConnections[#allConnections + 1] = conn
    return conn
end

-- если хочешь трекать всё вручную — используй trackConn(...) вместо UIS.InputBegan(...)
-- (оставлено на будущее, не обязательно к использованию)

local _oldDestroy = _G.SS_INSTANCE.destroy
_G.SS_INSTANCE.destroy = function()
    pcall(_oldDestroy)
    for _, c in ipairs(allConnections) do
        pcall(function() c:Disconnect() end)
    end
    pcall(function() if hitSound then hitSound:Destroy() end end)
    pcall(function()
        for _, t in ipairs(parallaxTargets) do
            if t.obj and t.obj.Parent then t.obj.Rotation = t.baseRot end
        end
    end)
    setStatus("destroyed")
end

