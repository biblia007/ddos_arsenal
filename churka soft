                                                    l.Visible = true
                                                else l.Visible = false end
                                            else l.Visible = false end
                                        else l.Visible = false end
                                    end
                                else
                                    for _, l in ipairs(d.skel) do l.Visible = false end
                                end

                                -- glow
                                if CFG.glow_enabled then
