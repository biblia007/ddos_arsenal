-- ===================== MAIN LOOP =====================
local frameCount, fpsAcc = 0, 0
local lastAimTarget = nil

RunService.RenderStepped:Connect(function(dt)
    frameCount = frameCount + 1; fpsAcc = fpsAcc + dt
    if fpsAcc >= 0.5 then
        fpsTxt.Text = string.format("FPS %d", math.floor(frameCount / fpsAcc))
        frameCount, fpsAcc = 0, 0
    end

    if not unlocked then return end
    Cam = WS.CurrentCamera
    local acc = c3(CFG.accent)

    -- watermark / fps
    wm.Visible = CFG.watermark
    wm.Color = acc
    wm.Text = "СЛЁЗЫ САТАНЫ v" .. VERSION .. "  |  MM2"
    wmTg.Visible = CFG.tg_watermark
    fpsTxt.Visible = CFG.fps_counter

    -- fov circle
    fovPulse = 1 + math.sin(tick() * 3) * 0.08
    fovCircle.Visible = CFG.fov_circle and CFG.aim_enabled
    fovCircle.Position = Vector2.new(Cam.ViewportSize.X / 2, Cam.ViewportSize.Y / 2)
    fovCircle.Radius = CFG.fov_pulse and (CFG.aim_fov * fovPulse) or CFG.aim_fov
    fovCircle.Color = c3(CFG.aim_fov_color or CFG.fov_color)

    -- hitmarker
    if hitmarkT > 0 then
        hitmarkT = hitmarkT - dt
        if hitmarkT <= 0 then
            hitmark.Visible = false; hitmark2.Visible = false
        end
    end

    -- killfeed
    if killFeedT > 0 then
        killFeedT = killFeedT - dt
        killFeed.Text = killFeedText
        killFeed.Visible = CFG.hitmarker
    else
        killFeed.Visible = false
    end

    -- aim
    if CFG.aim_enabled and aimHeld and CFG.aim_mode ~= "Silent" then
        local t = closestTarget()
        lastAimTarget = t
        if t then
            local target = t.Position
            if CFG.aim_prediction > 0 then
                target = target + (t.AssemblyLinearVelocity or Vector3.zero) * CFG.aim_prediction
            end
            local goal = CFrame.new(Cam.CFrame.Position, target)
            if CFG.aim_mode == "Camera" then
                Cam.CFrame = Cam.CFrame:Lerp(goal, 1 - CFG.aim_smooth)
            elseif CFG.aim_mode == "Mouse" and mousemoverel then
                local sp = Cam:WorldToViewportPoint(target)
                local center = Vector2.new(Cam.ViewportSize.X / 2, Cam.ViewportSize.Y / 2)
                local delta = Vector2.new(sp.X, sp.Y) - center
                mousemoverel(math.floor(delta.X * (1 - CFG.aim_smooth)), math.floor(delta.Y * (1 - CFG.aim_smooth)))
            end
            if CFG.auto_fire and mouse1click then
                local now = tick() * 1000
                if now - lastAutoFire >= CFG.auto_fire_delay then
                    lastAutoFire = now
                    pcall(mouse1click)
                end
            end
            if CFG.hitmarker then
                local sp = Vector2.new(Cam.ViewportSize.X / 2, Cam.ViewportSize.Y / 2)
                hitmark.From  = sp - Vector2.new(8, 8)
                hitmark.To    = sp - Vector2.new(3, 3)
                hitmark2.From = sp + Vector2.new(3, 3)
                hitmark2.To   = sp + Vector2.new(8, 8)
                hitmark.Visible = true; hitmark2.Visible = true
                hitmarkT = 0.14
            end
        end
    end

    tryTrigger()

    -- ESP
    local players = Players:GetPlayers()
    local seen = {}
    for i = 1, #players do
        local plr = players[i]
        if plr ~= LP then
            seen[plr] = true
            local d = draws[plr]
            if d then
                local ch = plr.Character
                local hum = ch and ch:FindFirstChildOfClass("Humanoid")
                if not CFG.esp_enabled or not ch or not hum or hum.Health <= 0 then
                    hide(d)
                else
                    local hrp = ch:FindFirstChild("HumanoidRootPart")
                    if not hrp then
                        hide(d)
                    else
                        local dist = (Cam.CFrame.Position - hrp.Position).Magnitude
                        if dist > CFG.esp_dist_limit then
                            hide(d)
                        else
                            local ok, sp = onScreen(hrp.Position)
                            if not ok then
                                hide(d)
                            else
                                local col = roleColor(plr)
                                local head = ch:FindFirstChild("Head")
                                local top, bot
                                if head then
                                    local o1, hp = onScreen(head.Position + Vector3.new(0, 0.5, 0))
                                    local o2, bp = onScreen(hrp.Position - Vector3.new(0, 3, 0))
                                    if o1 and o2 then top, bot = hp, bp end
                                end

                                -- box
                                if top and bot and CFG.esp_box then
                                    local h = bot.Y - top.Y
                                    local w = h * 0.6
                                    local pos = Vector2.new(top.X - w/2, top.Y)
                                    d.box.Size = Vector2.new(w, h)
                                    d.box.Position = pos
                                    d.box.Color = CFG.esp_role_color and col or c3(CFG.esp_box_color)
                                    d.box.Thickness = CFG.esp_thickness
                                    d.box.Visible = true
                                    if CFG.esp_fill then
                                        d.boxFill.Size = Vector2.new(w, h)
                                        d.boxFill.Position = pos
                                        d.boxFill.Color = d.box.Color
                                        d.boxFill.Transparency = CFG.esp_fill_transparency
                                        d.boxFill.Visible = true
                                    else
                                        d.boxFill.Visible = false
                                    end
                                else
                                    d.box.Visible = false
                                    d.boxFill.Visible = false
                                end

                                -- name
                                d.name.Text = CFG.streamer_mode and "player" or plr.Name
                                d.name.Position = Vector2.new(sp.X, sp.Y - 46)
                                d.name.Color = col
                                d.name.Visible = CFG.esp_name

                                -- hp
                                d.hp.Text = string.format("%d", math.floor(hum.Health))
                                d.hp.Position = Vector2.new(sp.X + 40, sp.Y)
                                d.hp.Visible = CFG.esp_health

                                -- dist
                                d.dist.Text = string.format("%d m", math.floor(dist))
                                d.dist.Position = Vector2.new(sp.X, sp.Y + 40)
                                d.dist.Color = col
                                d.dist.Visible = CFG.esp_dist

                                -- weapon
                                if CFG.esp_weapon then
                                    local wpn = getWeapon(plr)
                                    d.weapon.Text = wpn and ("["..wpn.."]") or ""
                                    d.weapon.Position = Vector2.new(sp.X, sp.Y + 56)
                                    d.weapon.Color = col
                                    d.weapon.Visible = wpn ~= nil
