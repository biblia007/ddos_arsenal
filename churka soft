local function slider(parent, lbl, key, min, max, step, fmt, cb)
    local r = card(parent, 48)
    new("TextLabel", {
        Size = UDim2.new(1,-110,0,18), Position = UDim2.new(0,12,0,4),
        BackgroundTransparency = 1, Text = lbl,
        Font = FONT.reg, TextSize = 13, TextColor3 = Color3.fromRGB(225,235,230),
        TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd, Parent = r,
    })
    local valLbl = new("TextLabel", {
        Size = UDim2.new(0,100,0,18), Position = UDim2.new(1,-112,0,4),
        BackgroundTransparency = 1, Text = fmt and fmt(CFG[key]) or tostring(CFG[key]),
        Font = FONT.med, TextSize = 12, TextColor3 = c3(CFG.accent),
        TextXAlignment = Enum.TextXAlignment.Right, TextTruncate = Enum.TextTruncate.AtEnd, Parent = r,
    })
    local track = new("Frame", {
        Size = UDim2.new(1,-24,0,4), Position = UDim2.new(0,12,0,32),
        BackgroundColor3 = Color3.fromRGB(40,52,46), Parent = r,
    })
    corner(track, 2)
    local fill = new("Frame", {
        Size = UDim2.new(math.clamp((CFG[key]-min)/(max-min),0,1),0,1,0),
        BackgroundColor3 = c3(CFG.accent), Parent = track,
    })
    corner(fill, 2)
    local knob = new("Frame", {
        Size = UDim2.new(0,12,0,12),
        Position = UDim2.new(math.clamp((CFG[key]-min)/(max-min),0,1),-6,0.5,-6),
        BackgroundColor3 = Color3.fromRGB(255,255,255), Parent = track,
    })
    corner(knob, 6)
    stroke(knob, c3(CFG.accent), 1.5, 0.2)

    local dragging = false
    local function upd(x)
        pcall(function()
            local rel = math.clamp((x - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
            local v = min + (max - min) * rel
            v = math.floor(v/step + 0.5) * step
            CFG[key] = v
            fill.Size = UDim2.new(rel,0,1,0)
            knob.Position = UDim2.new(rel,-6,0.5,-6)
            valLbl.Text = fmt and fmt(v) or tostring(v)
            if cb then cb(v) end
            saveCfg()
        end)
    end
    track.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true; pcall(function() upd(i.Position.X) end)
        end
    end)
    UIS.InputChanged:Connect(function(i)
        if not dragging then return end
        if i.UserInputType ~= Enum.UserInputType.MouseMovement then return end
        pcall(function() upd(i.Position.X) end)
    end)
    UIS.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end
    end)
end

