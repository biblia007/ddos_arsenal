-- ===================== COLORS =====================
local function c3(t)
    if type(t) ~= "table" then return Color3.fromRGB(80, 255, 140) end
    return Color3.fromRGB(
        math.clamp(math.floor(tonumber(t[1]) or 80), 0, 255),
        math.clamp(math.floor(tonumber(t[2]) or 255), 0, 255),
        math.clamp(math.floor(tonumber(t[3]) or 140), 0, 255)
    )
end
local function fixColor(t, fb)
    if type(t) ~= "table" then return fb end
    local r,g,b = tonumber(t[1]),tonumber(t[2]),tonumber(t[3])
    if not (r and g and b) then return fb end
    return {math.clamp(math.floor(r),0,255), math.clamp(math.floor(g),0,255), math.clamp(math.floor(b),0,255)}
end

