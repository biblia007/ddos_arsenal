-- ===================== HELPERS =====================
local function isAlive(plr)
    local ch = plr.Character
    if not ch then return false end
    local h = ch:FindFirstChildOfClass("Humanoid")
    return h and h.Health > 0
end

local function onScreen(pos)
    local sp, vis = Cam:WorldToViewportPoint(pos)
    return vis and sp.Z > 0, Vector2.new(sp.X, sp.Y)
end

-- MM2 role resolver с кэшем
function getRole(plr)
    local cached = cache.roleCache[plr]
    if cached then return cached end
    local ch = plr.Character
    if not ch then return "Unknown" end
    local r
    if ch:FindFirstChild("Knife") then r = "Killer"
    elseif ch:FindFirstChild("Gun") or ch:FindFirstChild("Revolver") then r = "Sheriff"
    else
        local hum = ch:FindFirstChildOfClass("Humanoid")
        r = (hum and hum.Health > 0) and "Innocent" or "Unknown"
    end
    cache.roleCache[plr] = r
    return r
end

local function getWeapon(plr)
    local ch = plr.Character
    if not ch then return nil end
    for _, tool in ipairs(ch:GetChildren()) do
        if tool:IsA("Tool") then return tool.Name end
    end
    return nil
end

local function roleColor(plr)
    if not CFG.esp_role_color then return c3(CFG.esp_color) end
    local r = getRole(plr)
    return c3(CFG.role_colors[r] or CFG.role_colors.Unknown)
end

local function targetFilter(plr)
    local role = getRole(plr)
    if CFG.aim_ignore_innocent and role == "Innocent" then return false end
    if CFG.aim_ignore_sheriff and role == "Sheriff" then return false end
    return true
end

-- ===================== AIM =====================
local function closestTarget()
    local best, bestD = nil, CFG.aim_fov
    local center = Vector2.new(Cam.ViewportSize.X / 2, Cam.ViewportSize.Y / 2)
    local players = Players:GetPlayers()
    for i = 1, #players do
        local plr = players[i]
        if plr ~= LP and isAlive(plr) and targetFilter(plr) then
            local ch = plr.Character
            local part = ch:FindFirstChild(CFG.aim_part) or ch:FindFirstChild("HumanoidRootPart")
            if part then
                local hrp = ch:FindFirstChild("HumanoidRootPart")
                if not hrp or (Cam.CFrame.Position - hrp.Position).Magnitude <= CFG.aim_dist_limit then
                    local vis, sp = onScreen(part.Position)
                    if vis then
                        local d = (sp - center).Magnitude
                        if d < bestD then
                            if CFG.aim_wall_check then
                                local dir = part.Position - Cam.CFrame.Position
                                local ray = Ray.new(Cam.CFrame.Position, dir.Unit * dir.Magnitude)
                                local hit = WS:FindPartOnRayWithIgnoreList(ray, {LP.Character})
                                if not hit or hit:IsDescendantOf(ch) then
                                    best, bestD = part, d
                                end
                            else
                                best, bestD = part, d
                            end
                        end
                    end
                end
            end
        end
    end
    return best
end

local function cursorTarget()
    local m = Mouse.Target
    if not m then return nil end
    local model = m:FindFirstAncestorOfClass("Model")
    if not model then return nil end
    local plr = Players:GetPlayerFromCharacter(model)
    if not plr or plr == LP then return nil end
    return plr, m
end

-- ===================== SILENT HOOK =====================
local oldNamecall
if hookmetamethod and getnamecallmethod then
    pcall(function()
        oldNamecall = hookmetamethod(game, "__namecall", function(self, ...)
            local method = getnamecallmethod()
            if CFG.aim_enabled and CFG.aim_mode == "Silent"
               and (method == "Fire" or method == "FindPartOnRay") then
                local target = closestTarget()
                if target then
                    local args = {...}
                    for i, a in ipairs(args) do
                        if typeof(a) == "Vector3" then
                            args[i] = (target.Position - Cam.CFrame.Position).Unit
                            break
                        end
                    end
                    return oldNamecall(self, table.unpack(args))
                end
            end
            return oldNamecall(self, ...)
        end)
    end)
end

