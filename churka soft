                AutoButtonColor = false, Parent = holder,
            })
            corner(b, 6)
            b.MouseButton1Click:Connect(function()
                currentMode = n
                for k, v in pairs(MODES[n]) do CFG[k] = v end
                saveCfg(); rebuild()
                if modeLbl then modeLbl.Text = "MODE: "..n end
                setStatus("mode: "..n)
