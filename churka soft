-- ===================== TRIGGER =====================
local lastTrig, lastAutoFire = 0, 0
local function tryTrigger()
    if not CFG.trigger_enabled then return end
    if CFG.trigger_key ~= "None" and not trigHeld then return end
    local plr
    if CFG.trigger_mode == "Cursor" then
        plr = cursorTarget()
    else
        local t = closestTarget()
        if t then plr = Players:GetPlayerFromCharacter(t.Parent) end
    end
    if not plr then return end
    if not targetFilter(plr) then return end
    local now = tick() * 1000
    if now - lastTrig < CFG.trigger_delay then return end
    lastTrig = now
    if mouse1click then pcall(mouse1click) end
end

